                            <div class="card-body text-center">
                                <i class="bi bi-shield-lock-fill text-success display-4" aria-hidden="true"></i>
                                <h3 class="h4 mt-4">Secure</h3>
                                <p>Perfect for any single subscription Azure deployment.</p>
                            </div>
                        </article>
                    </div>

                    <div class="col-md-4">
                        <article class="card feature-card h-100">
                            <div class="card-body text-center">
                                <i class="bi bi-gear-fill text-warning display-4" aria-hidden="true"></i>
                                <h3 class="h4 mt-4">Easy to Configure</h3>
                                <p>Simple to configure.</p>
                            </div>
                        </article>
                    </div>
                </div>
            </div>
        </section>

        <section class="section bg-white">
            <div class="container">
